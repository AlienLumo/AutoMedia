# 默认：自动识别文本，统一 LF
* text=auto eol=lf

# Windows 脚本保持 CRLF（PowerShell 5.1 / cmd.exe 更稳）
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.vbs text eol=crlf

# 二进制资源不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.bmp binary
*.tif binary
*.tiff binary
*.psd binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
*.mp4 binary
*.mov binary
*.wav binary
*.mp3 binary
*.m4a binary
*.zip binary
*.7z binary
*.pdf binary
